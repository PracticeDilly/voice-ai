NODE_ENV=development
PORT=8081
LOG_LEVEL=debug

# Public WebSocket URL used in TwiML:
# <ConversationRelay url="wss://voiceapitest.practicedilly.com/ai/conversation" />
PUBLIC_WS_URL=wss://voiceapitest.practicedilly.com/ai/conversation

# Scheduling / VOIP Spring Boot application
SPRING_BOOT_BASE_URL=https://voiceapitest.practicedilly.com
SPRING_BOOT_SERVICE_TOKEN=replace-with-service-token

# OpenAI
OPENAI_API_KEY=replace-with-openai-key
OPENAI_MODEL=gpt-4.1-mini

# Conversation behavior
AI_MAX_SESSION_MINUTES=20
AI_DEFAULT_OFFICE_TIMEZONE=America/Los_Angeles
