{
  "name": "docproxy-voice-ai-node",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js AI receptionist WebSocket service for Twilio Conversation Relay.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsx --test tests/appointments/appointmentConfirmation.test.ts tests/appointments/appointmentLookupCache.test.ts tests/appointments/appointmentPendingAction.test.ts tests/appointments/nextAppointment.test.ts tests/conversation/aiReceptionistOrchestrator.test.ts tests/conversation/promptBuilder.test.ts tests/conversation/toolPolicy.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "openai": "^4.104.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
